# Downloaded papers, SI and data files are copyrighted; keep them local.
# The per-mineral papers.csv bibliographies and the peak CSVs stay tracked.
calcite/*/
anatase/*/
mos2/*/
quartz/*/
silicon/*/
__pycache__/
# Agents' scratch work: rendered paper pages, exported spectra, backups
peaks/*/_work/

# Search claims are coordination files, not data
calcite/_claims.txt
anatase/_claims.txt

# Checker page renders (copyrighted pages)
data/mode_card_sources/_check/

# Search agents' API caches and logs (intermediate; may hold copied abstracts). Their .py scripts stay tracked.
scripts/*_search*/**/*.json
scripts/*_search*/**/*.log
scripts/*_search*/**/*.txt
scripts/*_search*/*.json
scripts/*_search*/*.log
scripts/*_search*/*.txt
