# Project-level ignore rules for the Raman mode-assignment project.
# Folder-specific rules live next to the folder (e.g. Qiaomu/.gitignore keeps downloaded papers out).

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
.conda/

# --- marimo ---
__marimo__/
.marimo/

# --- Secrets and local config (API keys for Hugging Face, Adaption, etc.) ---
.env
.env.*
!.env.example
*.key
*token*.txt

# --- Model weights and caches (Qwen, fine-tuned checkpoints): download, don't commit ---
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.onnx
models/
checkpoints/
.cache/
hf_cache/
wandb/

# --- Logs and run outputs ---
*.log
runs/
outputs/

# --- Personal Qiaomu workspace (inside mode_cards) ---
mode_cards/Qiaomu/mos2/
mode_cards/Qiaomu/data/
mode_cards/Qiaomu/quartz/
mode_cards/Qiaomu/scripts/
mode_cards/Qiaomu/silicon/
mode_cards/Qiaomu/structures/
mode_cards/Qiaomu/Architecture Overview.md
mode_cards/Qiaomu/README.md
mode_cards/Qiaomu/Sequence of Execution.md
mode_cards/Qiaomu/feedback.md
mode_cards/Qiaomu/history.md
mode_cards/Qiaomu/memory.md
mode_cards/Qiaomu/requirements.txt

# --- Qiaomu workspace: downloaded papers and scratch files ---
# Downloaded papers, SI and data files are copyrighted; keep them local.
# The per-mineral papers.csv bibliographies and the peak CSVs stay tracked.
mode_cards/Qiaomu/calcite/*/
mode_cards/Qiaomu/anatase/*/
mode_cards/Qiaomu/mos2/*/
mode_cards/Qiaomu/quartz/*/
mode_cards/Qiaomu/silicon/*/

# Agents' scratch work: rendered paper pages, exported spectra, backups
mode_cards/Qiaomu/peaks/*/_work/

# Search claims are coordination files, not data
mode_cards/Qiaomu/calcite/_claims.txt
mode_cards/Qiaomu/anatase/_claims.txt

# Checker page renders (copyrighted pages)
mode_cards/Qiaomu/data/mode_card_sources/_check/

# Search agents' API caches and logs (intermediate; may hold copied abstracts). Their .py scripts stay tracked.
mode_cards/Qiaomu/scripts/*_search*/**/*.json
mode_cards/Qiaomu/scripts/*_search*/**/*.log
mode_cards/Qiaomu/scripts/*_search*/**/*.txt
mode_cards/Qiaomu/scripts/*_search*/*.json
mode_cards/Qiaomu/scripts/*_search*/*.log
mode_cards/Qiaomu/scripts/*_search*/*.txt

# --- OS, Google Drive and editor files ---
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
.tmp.drivedownload/
.tmp.driveupload/
.vscode/
.idea/
*.swp
